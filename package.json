{
  "name": "ainalyzer",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --workspace @ainalyzer/frontend run dev",
    "dev:backend": "npm --workspace @ainalyzer/backend run start:dev",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --workspace @ainalyzer/frontend run lint",
    "lint:backend": "npm --workspace @ainalyzer/backend run lint",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --workspace @ainalyzer/frontend run build",
    "build:backend": "npm --workspace @ainalyzer/backend run build"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "prettier": "^3.0.0"
  }
}
